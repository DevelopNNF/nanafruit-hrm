# Copy this file to `.env` and fill in PGPASSWORD and the ENTRA_* values.
# `.env` is git-ignored — never commit real credentials.

# HTTP server
PORT=3000
# Comma-separated. admin runs on 5173, liff on 5174.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# How many reverse proxies sit in front of this server. 0 in dev, where nothing
# does. Behind one load balancer it is 1, behind a CDN in front of a balancer, 2.
# The rate limiter identifies callers by IP and reads it through this: set it too
# low and everyone shares one bucket, too high and the header can be forged.
TRUST_PROXY=0

# Microsoft Entra ID — from the app registration's Overview page. Both are
# required: the server refuses to start without them, because a default tenant
# or audience would mean accepting tokens it should reject.
#
# Neither is secret (the same two values ship inside admin's bundle), but the
# app registration must have accessTokenAcceptedVersion: 2 in its manifest or
# every token will fail the issuer check.
ENTRA_TENANT_ID=
# Application (client) ID. Also the expected `aud` on incoming access tokens.
ENTRA_API_CLIENT_ID=

# LINE — from the LINE Developers Console.
#
# The Channel ID of the *Login channel* that the LIFF app belongs to (Basic
# settings tab). It is the numeric part of the LIFF ID: a LIFF ID of
# 1234567890-abcdEFGH belongs to channel 1234567890. Sent to LINE when verifying
# an ID token, which is how LINE knows to reject tokens minted for someone else.
# Not a secret. The Channel *Secret* is not needed and must never be added here
# with a VITE_ prefix anywhere.
LINE_CHANNEL_ID=

# Signing key for the sessions issued to liff/. This one IS a secret: anyone who
# has it can mint a session for any employee. At least 32 characters, and a
# different value in every environment. Generate one with:
#   openssl rand -base64 32
SESSION_JWT_SECRET=

# Attendance recompute trigger. Shared secret for POST /api/cron/attendance-daily,
# which an external scheduler (cron-job.org, or whatever the host provides) calls
# to rebuild attendance_daily. Sent by the scheduler as an `X-Cron-Key` header.
#
# This IS a secret: anyone holding it can make the server do the run repeatedly.
# It cannot read or change employee data — the endpoint only recomputes derived
# rows from what is already there — so it is not as dangerous as
# SESSION_JWT_SECRET, but treat it the same way. Generate one with:
#   openssl rand -base64 32
#
# Leave it empty to disable the endpoint: with no value the route answers 503,
# it never falls back to being open.
ATTENDANCE_CRON_SECRET=

# PostgreSQL — these names are the libpq standard, so `pg` picks them up directly.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=hrm_dev

# Notifications — LINE Messaging API push + email via a Power Automate flow.
# See server/src/notifications/ for the module. Each channel is independently
# optional: missing config for one just skips that send (and logs why to
# notification_log) rather than failing anything, so LINE and email can go
# live on separate days.
#
# Master kill switch. Defaults to off so a dev/staging copy of this database
# never pushes a real notification to a real person while testing — flip to
# true only once LINE/Power Automate are actually configured for that
# environment.
NOTIFICATIONS_ENABLED=false

# Channel access token for the LINE Messaging API channel used for push
# messages — LINE Developers Console, Messaging API tab. This is a DIFFERENT
# channel from LINE_CHANNEL_ID above (that one is the Login channel behind
# the LIFF app, and cannot push messages). This one IS a secret.
LINE_CHANNEL_ACCESS_TOKEN=

# HTTP trigger URL of the Power Automate flow that sends notification emails
# (it parses the posted JSON — subject/bodyHtml, no recipient — then runs an
# Office 365 Outlook "Send an email" action). Treat as a secret — the URL
# itself is the only auth Power Automate's HTTP trigger has.
#
# Recipients (e.g. who counts as "HR" for a request reaching the 'hr'
# approval stage) are configured inside the flow itself, not here — its
# "Send an email" step's To field, static or pulled from a SharePoint/Excel
# list. That way HR can change who gets notified without a server deploy;
# HRM.HR/HRM.Admin are Entra App Roles checked at login anyway, not rows in
# this database, so there was never a "who has this role" table to read.
POWER_AUTOMATE_WEBHOOK_URL=

# Cloudflare R2 — object storage for uploaded files (employee photos to start).
# Create the bucket and a bucket-scoped API token in the Cloudflare dashboard
# under R2 → Manage API Tokens. The bucket must stay private: reads go through
# a presigned URL the server mints per request, not a public bucket URL.
#
# None of these may ever get a VITE_ prefix — the access/secret keys must
# never reach admin's bundle.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
